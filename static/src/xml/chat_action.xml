<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ai_data_chat.ChatAction">
        <div class="o_ai_chat d-flex h-100">

            <!-- Barra lateral: conversaciones -->
            <div class="o_ai_chat_sidebar d-flex flex-column border-end">
                <div class="p-2 border-bottom">
                    <button class="btn btn-primary w-100" t-on-click="() => this.newSession()">
                        <i class="fa fa-plus me-1"/> Nueva conversación
                    </button>
                </div>
                <div class="flex-grow-1 overflow-auto">
                    <t t-foreach="state.sessions" t-as="s" t-key="s.id">
                        <div class="o_ai_chat_session_item p-2 border-bottom"
                             t-att-class="{ 'o_active': s.id === state.activeId }"
                             t-on-click="() => this.selectSession(s.id)">
                            <div class="text-truncate fw-bold" t-esc="s.name"/>
                            <small class="text-muted">
                                <span t-esc="s.message_count"/> mensajes
                                <t t-if="s.state === 'closed'"> · cerrada</t>
                            </small>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Panel principal -->
            <div class="o_ai_chat_main d-flex flex-column flex-grow-1">

                <div class="o_ai_chat_thread flex-grow-1 overflow-auto p-3" t-ref="thread">
                    <t t-if="!state.messages.length">
                        <div class="text-muted text-center mt-5">
                            Escribe una pregunta sobre tus datos de Ventas, Compras, Contactos o Productos.
                        </div>
                    </t>
                    <t t-foreach="state.messages" t-as="m" t-key="m.id">
                        <div class="o_ai_chat_msg mb-3" t-att-class="'o_role_' + m.role">
                            <div class="o_ai_chat_bubble">
                                <div class="o_ai_chat_text" t-out="formatContent(m)"/>

                                <t t-set="table" t-value="resultRows(m)"/>
                                <div t-if="table" class="o_ai_chat_result mt-2">
                                    <table class="table table-sm table-striped mb-0">
                                        <thead>
                                            <tr>
                                                <th t-foreach="table.columns" t-as="c" t-key="c.key"
                                                    t-att-class="{ o_num: c.numeric and !c.isLabel, o_label: c.isLabel }"
                                                    t-esc="c.label"/>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="table.rows" t-as="row" t-key="row_index">
                                                <td t-foreach="table.columns" t-as="c" t-key="c.key"
                                                    t-att-class="{ o_num: c.numeric and !c.isLabel, o_label: c.isLabel }"
                                                    t-esc="cell(row[c.key], c)"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Ficha de confirmación de una escritura.
                                     Nada se ha escrito hasta que se pulsa. -->
                                <div t-if="m.action" class="o_ai_chat_action mt-2"
                                     t-att-class="'o_state_' + m.action.state">
                                    <div class="o_ai_chat_action_title">
                                        <i class="fa fa-pencil-square-o me-1"/>
                                        <t t-esc="m.action.preview.title"/>
                                    </div>

                                    <table class="table table-sm mb-0 mt-2"
                                           t-if="m.action.preview.lines.length">
                                        <tbody>
                                            <tr t-foreach="m.action.preview.lines" t-as="l" t-key="l.label">
                                                <th class="o_label" t-esc="l.label"/>
                                                <td t-esc="l.value"/>
                                            </tr>
                                        </tbody>
                                    </table>

                                    <table class="table table-sm mb-0 mt-2"
                                           t-if="m.action.preview.changes">
                                        <tbody>
                                            <tr t-foreach="m.action.preview.changes" t-as="c" t-key="c.label">
                                                <th class="o_label" t-esc="c.label"/>
                                                <td>
                                                    <span class="o_ai_chat_before" t-esc="c.before"/>
                                                    <i class="fa fa-long-arrow-right mx-2"/>
                                                    <span class="o_ai_chat_after" t-esc="c.after"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                    <!-- Documento con líneas (presupuesto de compra) -->
                                    <div t-if="m.action.preview.document" class="o_ai_chat_doc mt-2">
                                        <table class="table table-sm mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Producto</th>
                                                    <th class="o_num">Cant.</th>
                                                    <th class="o_num">Precio</th>
                                                    <th class="o_num">Subtotal</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="m.action.preview.document.rows" t-as="r" t-key="r_index">
                                                    <td t-esc="r.product"/>
                                                    <td class="o_num" t-esc="num(r.qty, 0)"/>
                                                    <td class="o_num" t-esc="num(r.price_unit)"/>
                                                    <td class="o_num" t-esc="num(r.subtotal)"/>
                                                </tr>
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="3" class="text-end">Base</td>
                                                    <td class="o_num" t-esc="num(m.action.preview.document.amount_untaxed)"/>
                                                </tr>
                                                <tr>
                                                    <td colspan="3" class="text-end">Impuestos</td>
                                                    <td class="o_num" t-esc="num(m.action.preview.document.amount_tax)"/>
                                                </tr>
                                                <tr class="fw-bold">
                                                    <td colspan="3" class="text-end">
                                                        Total <t t-esc="m.action.preview.document.currency"/>
                                                    </td>
                                                    <td class="o_num" t-esc="num(m.action.preview.document.amount_total)"/>
                                                </tr>
                                            </tfoot>
                                        </table>
                                        <div class="alert alert-warning py-1 px-2 mt-2 mb-0"
                                             t-if="m.action.preview.document.warnings.length">
                                            <t t-foreach="m.action.preview.document.warnings" t-as="w" t-key="w_index">
                                                <small class="d-block">
                                                    <i class="fa fa-exclamation-triangle me-1"/><t t-esc="w"/>
                                                </small>
                                            </t>
                                        </div>
                                    </div>

                                    <div class="o_ai_chat_defaults mt-2"
                                         t-if="m.action.preview.defaults.length">
                                        <small class="text-muted">
                                            Además, por defecto:
                                            <t t-esc="m.action.preview.defaults.join(' · ')"/>
                                        </small>
                                    </div>

                                    <div class="alert alert-warning py-1 px-2 mt-2 mb-0"
                                         t-if="m.action.preview.duplicates.length">
                                        <small>
                                            <i class="fa fa-exclamation-triangle me-1"/>
                                            Ya existe algo parecido:
                                            <t t-esc="m.action.preview.duplicates.map((d) => d.name).join(', ')"/>
                                        </small>
                                    </div>

                                    <div class="alert alert-danger py-1 px-2 mt-2 mb-0" t-if="m.action.error">
                                        <small t-esc="m.action.error"/>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 mt-2"
                                         t-if="m.action.state === 'draft'">
                                        <button class="btn btn-sm btn-primary"
                                                t-att-disabled="state.actionBusy === m.action.id"
                                                t-on-click="() => this.confirmAction(m)">
                                            <t t-esc="m.action.confirm_label"/>
                                        </button>
                                        <button class="btn btn-sm btn-secondary"
                                                t-att-disabled="state.actionBusy === m.action.id"
                                                t-on-click="() => this.discardAction(m)">
                                            Descartar
                                        </button>
                                        <small class="text-muted">Nada se ha guardado todavía.</small>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 mt-2"
                                         t-if="m.action.state === 'done'">
                                        <small class="text-success">
                                            <i class="fa fa-check me-1"/>Aplicado.
                                        </small>
                                        <a t-if="m.action.result_url"
                                           t-att-href="m.action.result_url">
                                            <small>Abrir en Odoo</small>
                                        </a>
                                        <button t-if="m.action.can_undo"
                                                class="btn btn-sm btn-link p-0"
                                                t-att-disabled="state.actionBusy === m.action.id"
                                                t-on-click="() => this.undoAction(m)">
                                            <small><i class="fa fa-undo me-1"/>Deshacer</small>
                                        </button>
                                        <small class="text-muted" t-elif="m.action.undo_blocked"
                                               t-esc="m.action.undo_blocked"/>
                                    </div>

                                    <div class="mt-2" t-if="m.action.state === 'reverted'">
                                        <small class="text-muted">
                                            <i class="fa fa-undo me-1"/>Cambio deshecho.
                                        </small>
                                        <a t-if="m.action.result_url" class="ms-2"
                                           t-att-href="m.action.result_url">
                                            <small>Abrir en Odoo</small>
                                        </a>
                                    </div>

                                    <div class="mt-2" t-if="m.action.state === 'discarded'">
                                        <small class="text-muted">Descartado. No se escribió nada.</small>
                                    </div>
                                    <div class="mt-2" t-if="m.action.state === 'expired'">
                                        <small class="text-muted">Propuesta caducada. Vuelve a pedirla.</small>
                                    </div>
                                </div>

                                <div t-if="m.tool_name" class="o_ai_chat_meta text-muted mt-1">
                                    <small>
                                        <i class="fa fa-wrench me-1"/>
                                        <t t-esc="m.tool_name"/>
                                        <t t-if="m.status === 'error'"> · error</t>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Entrada -->
                <div class="o_ai_chat_input d-flex align-items-end gap-2 p-3">
                    <textarea class="form-control" rows="2"
                              placeholder="Escribe tu pregunta…  (Enter para enviar)"
                              t-model="state.input"
                              t-on-keydown="onInputKeydown"/>
                    <button class="btn btn-primary"
                            t-att-disabled="state.loading || !state.input.trim()"
                            t-on-click="() => this.send()">
                        <t t-if="state.loading"><i class="fa fa-spinner fa-spin"/></t>
                        <t t-else="">Enviar</t>
                    </button>
                </div>

            </div>
        </div>
    </t>

</templates>
