<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="rule_ai_chat_session_own" model="ir.rule">
            <field name="name">Conversaciones: solo las propias</field>
            <field name="model_id" ref="model_ai_chat_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_ai_chat_session_admin" model="ir.rule">
            <field name="name">Conversaciones: administrador ve todo</field>
            <field name="model_id" ref="model_ai_chat_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_ai_chat_message_own" model="ir.rule">
            <field name="name">Mensajes: solo los de conversaciones propias</field>
            <field name="model_id" ref="model_ai_chat_message"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_ai_chat_message_admin" model="ir.rule">
            <field name="name">Mensajes: administrador ve todo</field>
            <field name="model_id" ref="model_ai_chat_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

    </data>
</odoo>
