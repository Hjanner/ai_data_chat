# --- ai_data_chat · configuración local (NO se versiona) ---------------------
# Copia este fichero a `.env` en la misma carpeta y rellena los valores.
# El módulo lo carga al arrancar (services/config.py). Precedencia:
#   ir.config_parameter  >  variable de entorno del proceso  >  este .env

# Proveedor LLM: gemini | openrouter | openai (todos hablan la API de OpenAI
# Chat Completions, así que cambiar de uno a otro es solo esto + la API key).
AI_DATA_CHAT_PROVIDER=gemini

# API key del proveedor elegido:
#   gemini      -> https://aistudio.google.com/apikey
#   openrouter  -> https://openrouter.ai/keys
#   openai      -> https://platform.openai.com/api-keys
AI_DATA_CHAT_API_KEY=

# Modelo. Por defecto se usa el preset del proveedor si se deja vacío:
#   gemini      -> gemini-3.6-flash
#   openrouter  -> anthropic/claude-3.5-haiku   (o cualquier slug de openrouter.ai/models)
#   openai      -> gpt-4o-mini
AI_DATA_CHAT_MODEL=

# Solo si usas un endpoint distinto al preset del proveedor (self-host, proxy...).
AI_DATA_CHAT_BASE_URL=

# Modo del responder: manual (sin IA) | llm
AI_DATA_CHAT_RESPONDER_MODE=manual

# Pasos de herramienta por pregunta. Los flujos de escritura necesitan uno
# más que los de consulta (buscar -> proponer -> redactar), por eso 4.
AI_DATA_CHAT_MAX_TOOL_ITERATIONS=4

# Timeout (segundos) de cada llamada HTTP al proveedor.
AI_DATA_CHAT_HTTP_TIMEOUT=60

# Cabeceras de atribución que recomienda OpenRouter (se ignoran con otros proveedores).
AI_DATA_CHAT_HTTP_REFERER=http://localhost
AI_DATA_CHAT_APP_TITLE=Odoo AI Data Chat
